{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monk3i Download Manager",
  "version": "0.2.0",
  "identifier": "com.monk3i.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monk3i Download Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Monk3i Systems",
    "copyright": "Copyright © 2026 Monk3i Systems",
    "category": "Utility",
    "shortDescription": "A reliable desktop download manager.",
    "longDescription": "Monk3i Download Manager is a Windows desktop download manager with queued downloads, pause and resume, media downloads, progress tracking, persistent history, and duplicate-download protection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
